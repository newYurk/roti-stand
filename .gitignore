# настройки Obsidian едут в git (цвета графа, вид, включённые плагины) — как в «Темари»;
# личное состояние окна у каждого своё
Roti-Obsidian/.obsidian/workspace.json
Roti-Obsidian/.obsidian/workspace-mobile.json

# Excalidraw — общий стандарт трёх хранилищ (Темари, Ролльня, Роти), 17.09.2026.
# Код плагинов в git не идёт никогда (у Excalidraw ~5 МБ). data.json плагинов — тоже: ИИ-режим Excalidraw
# хранит там ключи API, а репозиторий публичный; обязательные настройки записаны в docs/corpus-map.md.
# Список включённых плагинов (community-plugins.json) идёт в git.
# Перечисление по именам файлов пропускало всё прочее, что кладут плагины
# (у Breadcrumbs — data-backup после миграции настроек). Игнорируется папка целиком.
Roti-Obsidian/.obsidian/plugins/
# служебная папка плагина: скрипты из магазина (чужой код), библиотеки, шаблон, шрифты CJK (мегабайты)
Roti-Obsidian/Excalidraw/
# картинки в папке рисунков (экспорт и подложки) по умолчанию не в git; лёгкую картинку, на которую
# ссылается заметка, добавлять явно: git add -f (Home/CLAUDE.md, картинки в git)
Roti-Obsidian/Рисунки/**/*.png
Roti-Obsidian/Рисунки/**/*.svg
Roti-Obsidian/Рисунки/**/*.jpg
Roti-Obsidian/Рисунки/**/*.jpeg
Roti-Obsidian/Рисунки/**/*.webp
Roti-Obsidian/**/*.excalidraw.png
Roti-Obsidian/**/*.excalidraw.svg
